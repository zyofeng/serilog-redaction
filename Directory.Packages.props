<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Library">
    <PackageVersion Include="Microsoft.Extensions.Compliance.Abstractions" Version="10.11.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Extensions.Compliance.Abstractions" Version="11.0.0" Condition="'$(TargetFramework)' != 'net10.0'" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
  </ItemGroup>
  <ItemGroup Label="Build">
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.Extensions.Compliance.Redaction" Version="10.11.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Extensions.Compliance.Redaction" Version="11.0.0" Condition="'$(TargetFramework)' != 'net10.0'" />
    <PackageVersion Include="TUnit" Version="1.84.0" />
  </ItemGroup>
</Project>
